{
  "name": "suzumio",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "suzumio": "dist/cli.js",
    "suzumio-runner": "dist/runner.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:webui",
    "build:server": "tsc",
    "build:webui": "vite build --config webui/vite.config.ts",
    "webui:dev": "vite --config webui/vite.config.ts",
    "test": "npm run build:server && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webui/tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/google": "latest",
    "@ai-sdk/openai": "latest",
    "@ai-sdk/openai-compatible": "latest",
    "ai": "latest",
    "dockerode": "latest",
    "preact": "^10.29.2",
    "undici": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/dockerode": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4"
  }
}
